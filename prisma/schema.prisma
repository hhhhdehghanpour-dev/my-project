generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  profile      UserProfile?
  bodyCheckIns BodyCheckIn[]
  foodLogs     FoodLog[]
}

model UserProfile {
  id                Int    @id @default(autoincrement())
  userId            Int    @unique
  age               Int
  gender            String
  height            Float
  weight            Float
  targetWeight      Float
  waist             Float?
  bodyFat           Float?
  weightChangeSpeed Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BodyCheckIn {
  id        Int      @id @default(autoincrement())
  userId    Int
  weight    Float
  waist     Float?
  bodyFat   Float?
  note      String?
  checkedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, checkedAt])
}

model Food {
  id            Int       @id @default(autoincrement())
  name          String
  category      String
  calories      Float
  protein       Float
  carbohydrates Float
  fat           Float

  foodLogs FoodLog[]
}

model FoodLog {
  id            Int      @id @default(autoincrement())
  userId        Int
  foodId        Int?
  name          String
  meal          String
  quantity      Float
  calories      Float
  protein       Float
  carbohydrates Float
  fat           Float
  eatenAt       DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food? @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@index([userId, eatenAt])
}