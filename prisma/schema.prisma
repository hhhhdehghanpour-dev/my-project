generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  profile     UserProfile?
  bodyCheckIns BodyCheckIn[]
}

model UserProfile {
  id                Int    @id @default(autoincrement())
  userId            Int    @unique
  age               Int
  gender            String
  height            Float
  weight            Float
  targetWeight      Float
  waist             Float?
  bodyFat           Float?
  weightChangeSpeed Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BodyCheckIn {
  id       Int      @id @default(autoincrement())
  userId   Int
  weight   Float
  waist    Float?
  bodyFat  Float?
  note     String?
  checkedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, checkedAt])
}